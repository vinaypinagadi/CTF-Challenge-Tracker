{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CTF Challenge Event",
  "type": "object",
  "required": ["id", "title", "source_url", "source_name", "verification_status", "verified_at"],
  "properties": {
    "id": {"type": "string"},
    "title": {"type": "string"},
    "organizer": {"type": "string"},
    "company": {"type": "string"},
    "scope": {"enum": ["company", "community", "academic", "unknown"]},
    "source_name": {"type": "string"},
    "source_url": {"type": "string", "format": "uri"},
    "alternate_sources": {"type": "array", "items": {"type": "string", "format": "uri"}},
    "registration_url": {"type": ["string", "null"], "format": "uri"},
    "participation_url": {"type": ["string", "null"], "format": "uri"},
    "start_at": {"type": ["string", "null"], "format": "date-time"},
    "end_at": {"type": ["string", "null"], "format": "date-time"},
    "official_timezone": {"type": ["string", "null"]},
    "mode": {"enum": ["online", "hybrid", "in_person", "unknown"]},
    "remote_eligibility": {"enum": ["eligible", "not_eligible", "unknown"]},
    "joinable_from_user_region": {"enum": ["yes", "no", "unknown"]},
    "user_region": {"type": ["string", "null"]},
    "tags": {"type": "array", "items": {"type": "string"}},
    "difficulty": {"type": ["string", "null"]},
    "registration_status": {"enum": ["open", "opens_soon", "closed", "unknown"]},
    "prize": {"type": ["string", "null"]},
    "format": {"type": ["string", "null"]},
    "verification_status": {"enum": ["verified", "partially_verified", "rejected"]},
    "verified_at": {"type": "string", "format": "date-time"},
    "verification_evidence": {"type": "array", "items": {"type": "string"}},
    "last_seen_at": {"type": ["string", "null"], "format": "date-time"},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
